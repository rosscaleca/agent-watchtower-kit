<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.watchtower.__SOURCE__</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__REPO__/daemons/__SOURCE___wake.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Baked from the installing shell by `just install` so shutil.which()
             finds gh/bkt wherever that machine keeps them (nix profiles,
             /usr/local, ...) — launchd's default PATH is only /usr/bin:/bin:
             /usr/sbin:/sbin. Re-run `just install` if tool locations change. -->
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/watchtower/daemon-__SOURCE__.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/watchtower/daemon-__SOURCE__.log</string>
</dict>
</plist>
